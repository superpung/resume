<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{#if iconSvg}}<link rel="icon" href="{{iconSvg}}" type="image/svg+xml">{{/if}}
    {{#if resume.configs.icon_png}}<link rel="icon" href="{{resume.configs.icon_png}}" type="image/png">{{/if}}
    {{#if resume.configs.icon_apple}}<link rel="apple-touch-icon" href="{{resume.configs.icon_apple}}">{{/if}}
    <title>{{title}}</title>
    <meta name="description" content="{{description}}">
    <link rel="canonical" href="{{resume.configs.site_url}}">
    <meta property="og:type" content="profile">
    <meta property="og:title" content="{{title}}">
    <meta property="og:description" content="{{description}}">
    <meta property="og:url" content="{{resume.configs.site_url}}">
    <meta property="og:image" content="{{image}}">
    <meta name="twitter:card" content="summary">
    {{!-- email_off keeps Cloudflare from rewriting the email in the structured data --}}
    <!--email_off--><script type="application/ld+json">{{{jsonLd}}}</script><!--/email_off-->
    <script defer src="https://umami.superpung.cn/script.js" data-website-id="26150785-a480-43de-9bb2-a192ba31561f"></script>
    <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <style>{{{css}}}</style>
  </head>

  <body>

    <div class="container">
      <header class="row">
        <div class="card-wrapper">
          {{#resume.basics}}
          <div class="card">
            <div class="profile-card">
                <div class="profile-pic">
                  <img class="media-object img-circle center-block"  data-src="holder.js/100x100"
                    alt="{{name}}" src="{{picture}}">
                </div>
                <div class="contact-details">
                  <div class="name-and-profession">
                    <h1 class="text-bolder name"> {{name}}</h1>
                    <div class="text-muted profession">{{label}}</div>
                  </div>

                  {{#if address}}
                    <div class="text-muted info" style="font-size:0.9em">{{address}}</div>
                  {{/if}}

                  {{#if email}}
                    <div class="detail">
                      <span class="info">
                        <!--email_off--><a href="mailto:{{email}}" class="link-disguise" target="_blank">{{email}}</a><!--/email_off-->
                      </span>
                    </div>
                  {{/if}}
                </div>

              <div class="social-links">
                {{#profiles}}
                  <a class="social-link icon" href="{{url}}" target="_blank" title="{{network}}" aria-label="{{network}}">
                    {{toSocialIcon network}}<span class="sr-only">{{network}}</span>
                  </a>
                {{/profiles}}
              </div>
            </div>
          </div>
          {{/resume.basics}}

        </div>
      </header>

      <main class="row page">
        <div class="card-wrapper">
          <div class="card background-card">

            <h2 id="about"><span class="title">About</span></h2>
            <div class="card-nested">
              <p> {{breaklines resume.basics.summary}} </p>
            </div>

            {{#if resume.news}}
            <h2 id="news" class="no-print"><span class="title">News</span></h2>
            <ul class="list-unstyled no-print">
              {{#each resume.news}}
              <li class="card-nested">
                <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      {{title}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      <small>{{date}}</small>
                    </p>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.education}}
            <h2 id="education"><span class="title">Education</span></h2>
            <ul class="list-unstyled">
              {{#each resume.education}}
                <li class="card-nested">
                  <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{degree}}</strong>,&nbsp;{{major}},&nbsp;{{institution}}
                    </p>
                    {{#if description}}
                      <p class="clear-margin-sm"><i>{{description}}</i></p>
                    {{/if}}
                    <p class="text-muted clear-margin-sm">
                      <small>
                        {{startDate}} &ndash; {{#if endDate}}{{endDate}}{{else}}Now{{/if}}
                      </small>
                    </p>
                  </div>
                </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.interests}}
            <h2 id="interests"><span class="title">Research Interests</span></h2>
            <ul class="list-unstyled">
              {{#each resume.interests}}
              <li class="card-nested">
                <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{topic}}</strong>{{#if description}}:&nbsp;{{description}}{{/if}}
                    </p>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.publications}}
            <h2 id="publications"><span class="title">Publications</span></h2>
            <ol class="list-unstyled">
              {{#each resume.publications}}
                <li class="card-nested" style="margin-bottom: 0.5em">
                  <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <span class="text-box">{{publisher}}</span>
                      <strong>{{title}}</strong>
                      <span class="badge">{{grade}}</span>
                    </p>
                    <p class="clear-margin">{{authors}}</p>
                    <p class="clear-margin-sm citation">
                      <small>
                        {{description}}
                      </small>
                    </p>
                    <p class="clear-margin-sm">
                      <small class="split-items">
                        {{#if doi}}
                          <a href="{{doi}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'link'}} DOI
                          </a>
                        {{/if}}
                        {{#if pdf}}
                          <a href="{{pdf}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'pdf'}} PDF
                          </a>
                        {{/if}}
                        {{#if homepage}}
                          <a href="{{homepage}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'homepage'}} Homepage
                          </a>
                        {{/if}}
                        {{#if code}}
                          <a href="{{code}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'code'}} Code
                          </a>
                        {{/if}}
                        {{#if artifacts}}
                          <a href="{{artifacts}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'artifacts'}} Artifacts
                          </a>
                        {{/if}}
                         {{#if slides}}
                          <a href="{{slides}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'slides'}} Slides
                          </a>
                        {{/if}}
                         {{#if video}}
                          <a href="{{video}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'video'}} Video
                          </a>
                        {{/if}}
                        {{#if poster}}
                          <a href="{{poster}}" class='text-icon' target="_blank">
                            {{toSocialIcon 'poster'}} Poster
                          </a>
                        {{/if}}
                        {{#if bibtex}}
                          <a href="#" class='text-icon bibtex-copy no-print' role="button" data-bibtex="{{bibtex}}" title="Copy BibTeX">
                            {{toSocialIcon 'bibtex'}} <span class="bibtex-label">BibTeX</span>
                          </a>
                        {{/if}}
                      </small>
                    </p>
                    {{#if highlight}}
                    <p class="clear-margin highlight">{{highlight}}</p>
                    {{/if}}
                    {{#if @last}}{{#if @root.hasCorrespondingAuthor}}
                    <p class="clear-margin-sm list-note text-muted"><small>* Corresponding author</small></p>
                    {{/if}}{{/if}}
                  </div>
                </li>
              {{/each}}
            </ol>
            {{/if}}

            {{#if resume.projects}}
            <h2 id="projects"><span class="title">Research Projects</span></h2>
            <ul class="list-unstyled">
              {{#each resume.projects}}
              <li class="card-nested">
                <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{title}}</strong>,&nbsp;{{institution}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      {{description}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      <small>
                        {{startDate}} &ndash; {{#if endDate}}{{endDate}}{{else}}Now{{/if}}
                      </small>
                    </p>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.patents}}
            <h2 id="patents"><span class="title">Patents</span></h2>
            <ul class="list-unstyled">
              {{#each resume.patents}}
              <li class="card-nested">
                <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      {{title}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      {{description}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      <small>{{date}}</small>
                    </p>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.talks}}
            <h2 id="talks"><span class="title">Talks</span></h2>
            <ul class="list-unstyled">
              {{#each resume.talks}}
              <li class="card-nested" style="margin-bottom: 0.5em">
                <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{title}}</strong>,&nbsp;{{#if website}}<a href="{{website}}" target="_blank">{{publisher}}</a>{{else}}{{publisher}}{{/if}}
                    </p>
                    {{#if description}}
                      <p class="clear-margin-sm">
                        {{description}}
                      </p>
                    {{/if}}
                    <p class="text-muted clear-margin-sm">
                      <small class="split-items">
                        {{date}}
                        {{#if location}}
                          <span>{{location}}</span>
                        {{/if}}
                        {{#if slides}}
                          <a href="{{slides}}" class='icon' target="_blank" title="Slides" aria-label="Slides">
                            {{toSocialIcon 'slides'}}<span class="sr-only">Slides</span>
                          </a>
                        {{/if}}
                        {{#if video}}
                          <a href="{{video}}" class='icon' target="_blank" title="Video" aria-label="Video">
                            {{toSocialIcon 'video'}}<span class="sr-only">Video</span>
                          </a>
                        {{/if}}
                      </small>
                    </p>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.services}}
            <h2 id="services"><span class="title">Academic Services</span></h2>
            <ul class="list-unstyled">
              {{#each resume.services}}
                <li class="card-nested">
                  <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{position}}</strong>,&nbsp;{{event}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      <small class="split-items">
                        {{date}}
                        {{#if location}}
                          <span>{{location}}</span>
                        {{/if}}
                      </small>
                    </p>
                  </div>
                </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.teaching}}
            <h2 id="teaching"><span class="title">Teaching</span></h2>
            <ul class="list-unstyled">
              {{#each resume.teaching}}
                <li class="card-nested">
                  <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      {{{course}}}
                    </p>
                    <p class="text-muted clear-margin-sm">
                      <small class="split-items">
                        {{date}}
                        {{#if location}}
                          <span>{{location}}</span>
                        {{/if}}
                      </small>
                    </p>
                  </div>
                </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.opensource}}
            <h2 id="opensource"><span class="title">Side Projects</span></h2>
            <ul class="list-unstyled">
              {{#each resume.opensource}}
              <li class="card-nested">
                <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{name}}</strong>{{#if description}}:&nbsp;{{description}}{{/if~}}
                      <small class="text-muted icon-links">
                        {{#if url}}
                          <a href="{{url}}" class='icon' target="_blank" title="GitHub" aria-label="GitHub">
                            {{toSocialIcon 'repo'}}<span class="sr-only">GitHub</span>
                          </a>
                        {{/if}}
                        {{#if homepage}}
                          <a href="{{homepage}}" class='icon' target="_blank" title="Homepage" aria-label="Homepage">
                            {{toSocialIcon 'homepage'}}<span class="sr-only">Homepage</span>
                          </a>
                        {{/if}}
                      </small>
                      {{#if role}}<span class="badge">{{role}}</span>{{/if}}
                    </p>
                </div>
              </li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if resume.awards}}
            <h2 id="awards"><span class="title">Honors & Awards</span></h2>
            <ul class="list-unstyled">
              {{#each resume.awards}}
                <li class="card-nested">
                  <div class="content has-sidebar">
                    <p class="clear-margin-sm">
                      <strong>{{title}}</strong>,&nbsp;{{awarder}}
                    </p>
                    {{#if description}}
                      <p class="clear-margin-sm"><i>{{description}}</i></p>
                    {{/if}}
                    <p class="text-muted clear-margin-sm">
                      <small> {{date}} </small>
                    </p>
                  </div>
                </li>
              {{/each}}
            </ul>
            {{/if}}

            <footer class="page-footer" style="text-align:center">
              <div class="detail no-print" style="font-size:1.5rem;margin-top:2rem;">
                {{!-- Relative, so every deploy, previews included, links to its own PDF --}}
                <a href="resume.pdf" class="info" target="_blank">
                  PDF Version
                </a>
              </div>
              <div class="detail print-only" style="font-size:1.5rem;margin-top:2rem;" >
                <a href={{#resume.configs}}{{site_url}}{{/resume.configs}} class="info" target="_blank">
                  Online Version
                </a>
              </div>
              <div class="last-updated" style="opacity:0.7; font-size:1.2rem; margin-top:1rem;">
                <p style="margin:0;">
                  Last updated: <time datetime="{{getBuildDate 'YYYY-MM-DD'}}">{{getBuildDate 'MMMM D, YYYY'}}</time>
                </p>
                <p class="detail no-print" id="busuanzi_container_site_pv" style="margin:0;">
                  Total site visits: <span id="busuanzi_value_site_pv"></span>
                </p>
              </div>
            </footer>
          </div>
        </div>
      </main>
    </div>
    <script>
      // Copy a publication's BibTeX and briefly show "Copied"
      document.querySelectorAll('.bibtex-copy').forEach(function (button) {
        button.addEventListener('click', function (event) {
          event.preventDefault();
          var text = button.getAttribute('data-bibtex');
          var copy = navigator.clipboard && window.isSecureContext
            ? navigator.clipboard.writeText(text)
            : new Promise(function (resolve, reject) {
                var area = document.createElement('textarea');
                area.value = text;
                area.style.position = 'fixed';
                area.style.opacity = '0';
                document.body.appendChild(area);
                area.select();
                var ok = document.execCommand('copy');
                document.body.removeChild(area);
                ok ? resolve() : reject();
              });
          var label = button.querySelector('.bibtex-label');
          copy.then(function () { label.textContent = 'Copied'; }, function () { label.textContent = 'Copy failed'; });
          clearTimeout(button.resetTimer);
          button.resetTimer = setTimeout(function () { label.textContent = 'BibTeX'; }, 1500);
        });
      });
    </script>
  </body>
</html>
