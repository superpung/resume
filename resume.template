    "label": "your professional title",
    "summary": "this will be displayed on About section on the right, use <a> to add a link, \n to add a line break.",
    "website": "your personal website url",
    "address": "your address",
    "email": "your email address",
    "profiles": [
      {
        "network": "Scholar",
        "username": "",
        "url": "https://scholar.google.com/"
      },
      {
        "network": "GitHub",
        "username": "",
        "url": "https://github.com/"
      },
      {
        "network": "LinkedIn",
        "url": "https://www.linkedin.com/in/",
        "username": ""
      },
      {
        "network": "ORCiD",
        "url": "https://orcid.org/"
