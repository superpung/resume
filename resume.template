  "news": [
    {
      "title": "a news title, use <a> to add a link",
      "date": "the news date, which format must be YYYY-MM-DD or YYYY-MM or YYYY"
    }
  ],
  "education": [
    {
      "institution": "an education institution",
      "major": "your major",
      "degree": "your degree, such as Computer Science",
      "startDate": "start date, which format must be YYYY-MM-DD or YYYY-MM or YYYY",
      "endDate": "end date, which format must be YYYY-MM-DD or YYYY-MM or YYYY",
      "description": "under the supervision of Prof. XXX, use <a> to add a link"
    }
  ],
  "interests": [
    {
      "topic": "a research topic, such as deep learning",
      "description": "description of your research topic"
    }
  ],
  "publications": [
    {
      "publisher": "a publisher name, such as IEEE'23",
      "grade": "the publisher grade, such as CCF-A",
      "title": "your publication title",
      "authors": [
        "author 1, it'll automatically become bold if the author is yourself",
        "author 2, it'll automatically become bold if the author is yourself",
        "author 3*, a trailing * marks the corresponding author and adds a note below the publications"
      ],
      "venue": "the publication venue, such as IEEE Transactions on Pattern Analysis and Machine Intelligence",
      "startDate": "the publication date, which format must be YYYY-MM-DD or YYYY-MM or YYYY; with a month it is cited as e.g. Nov. 2026",
      "endDate": "the publisher end date, which format must be YYYY-MM-DD or YYYY-MM or YYYY",
      "pages": "the pages of your publication, such as 1-12, or volume(issue):pages such as 45(11):5784-5797; empty means to appear",
      "location": "location of the conference, cited for proceedings",
      "highlight": "best paper award, etc.",
      "doi": "the doi link of your publication",
      "pdf": "url to your publication pdf file",
      "homepage": "url to your publication homepage",
      "code": "url to your publication code repository",
      "artifacts": "url to your publication artifacts",
      "slides": "url to your publication slides",
      "video": "url to your publication video",
      "poster": "url to your publication poster",
      "bibtex": "optional BibTeX entry for the copy button; left out, one is built from the fields above"
    }
  ],
  "projects": [
    {
      "title": "your project title",
      "institution": "institution of your project",
      "description": "description of your project",
      "startDate": "start date of your project, which format must be YYYY-MM-DD or YYYY-MM or YYYY",
      "endDate": "start date of your project, which format must be YYYY-MM-DD or YYYY-MM or YYYY"
    }
  ],
  "patents": [
    {
      "title": "your patents title",
      "description": "description of your patent",
      "date": "date of your patent, which format must be YYYY-MM-DD or YYYY-MM or YYYY"
    }
  ],
  "talks": [
    {
      "title": "your talk title",
      "publisher": "the publisher of your talk",
      "description": "description of your talk",
      "website": "website of the publisher",
      "location": "location of your talk",
      "slides": "url to your slides",
      "video": "url to your record video",
      "date": "date of your talk, which format must be YYYY-MM-DD or YYYY-MM or YYYY"
    }
  ],
  "services": [
    {
      "position": "your academic service position",
      "event": "the event of your academic service, such as AAAI'23",
      "location": "location of event",
      "date": "date of your position, which format must be YYYY-MM-DD or YYYY-MM or YYYY"
    }
  ],
  "teaching": [
    {
      "course": "your teaching course",
      "location": "location of your teaching course",
