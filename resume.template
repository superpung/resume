  "opensource": [
    {
      "name": "your open source project name",
      "url": "url to your project repository",
      "role": "your role in the project, such as Author, Maintainer or Contributor",
      "description": "description of your project, use <a> to add a link",
      "homepage": "url to your project homepage or documentation"
    }
  ],
  "awards": [
    {
      "title": "your award title",
      "awarder": "the awarder of your award",
      "description": "description of your award",
      "date": "date of your award, which format must be YYYY-MM-DD or YYYY-MM or YYYY, or a list of such dates for an award received several times"
    }
  ]
}
